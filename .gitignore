# 빌드 출력
build/

# 임시 디렉토리
_extract/
temp/
.temp/

# Claude Code 개인 설정 (팀 공유 X)
.claude/settings.local.json

# manual-digest 산출물 (사용자별, 외부 매뉴얼 다이제스트가 자동 생성)
.claude/manuals/

# pcb-design-digest 산출물 (사용자별, 보드 다이제스트가 자동 생성)
.claude/pcb-designs/

# doc-atomize 산출물 (사용자별, 원자 분할 조각·인덱스가 자동 생성)
.claude/atomized/

# *-setup 스킬이 설치하는 에이전트 복사본 + 에이전트 런타임 메모리
# (로컬/사용자별 생성물 — 플러그인 소스는 plugins/*/agents/ 에 있음)
.claude/agents/
.claude/agent-memory/

# manual-digest setup이 만드는 CLAUDE.md 백업
CLAUDE.md.bak.*

# plugin eval 실행 결과 (파일럿마다 누적, aggregate-result.json + report.html)
plugins/*/evals/results/

# 스킬 평가 워크스페이스 — raw 응답·timing은 무시, benchmark.md/.json은 유지
**/skills/*-workspace/iteration-*/eval-*/
**/skills/*-workspace/skill-snapshot/

# 편집기 / IDE
.vscode/
.idea/
*.swp

# Python 캐시 (검증 명령용)
__pycache__/
*.pyc

# OMC 상태
.omc/

# OS
.DS_Store
Thumbs.db

# Vivado 생성 파일
*.jou
*.log
*.str
*.bit
*.mcs
*.dcp
*.wdb
*.vcd
webtalk*/
.Xil/
vivado*.backup/
NA/

# 테스트
skill-test/

# KiCad 임시
*-backups/
*.kicad_sch-bak
fp-info-cache
.note.md

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
